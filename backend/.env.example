# Backend app config — copy to backend/.env

# --- Database ---
DATABASE_URL="postgresql://receipts:change-me-strong-password@localhost:5432/receipts_saas?schema=public"

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Claude API (the extraction agent) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# --- Object storage (MinIO / S3-compatible) ---
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=receipts-admin
S3_SECRET_KEY=change-me-strong-password
S3_BUCKET=receipt-images

# --- LINE Messaging API ---
# Create a channel at https://developers.line.biz/console/ (Messaging API)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- Telegram Bot API ---
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me-random-string

# --- App ---
PORT=3001
NODE_ENV=development
