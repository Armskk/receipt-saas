# Root env file — used by docker-compose.yml for the infra containers.
# Copy to .env and fill in. Backend/frontend have their own .env files too
# (backend/.env.example, frontend/.env.example) for app-level config.

# --- Postgres ---
POSTGRES_USER=receipts
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=receipts_saas
POSTGRES_PORT=5432

# --- Redis (BullMQ) ---
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage for receipt images) ---
MINIO_ROOT_USER=receipts-admin
MINIO_ROOT_PASSWORD=change-me-strong-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=receipt-images

# --- Domain (for Caddy automatic HTTPS in production) ---
APP_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com
